# Payload needs both. In production these come from Coolify, not from a file.
# DATABASE_URI is the standalone Coolify Postgres resource (see issue #41).
DATABASE_URI=postgres://user:password@host:5432/dbname
# Any long random string. Rotating it invalidates existing admin sessions.
PAYLOAD_SECRET=
# ForwardEmail API key, for password resets. Without it Payload writes mail to
# the console and no reset ever arrives. Lives in Doppler ericdahl-dev/prd.
# HTTP API, not SMTP -- ger3 blocks outbound 25/465/587 and those hang.
FORWARDEMAIL_API_KEY=
# Public origin. Password-reset links are built from this; unset, Payload emits
# a host-less path that is not a clickable link.
PAYLOAD_SERVER_URL=http://localhost:3000
